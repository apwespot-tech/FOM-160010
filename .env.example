# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Backend
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@db:5432/app_test
JWT_SECRET=change-me-to-a-long-random-string

# Тестовая ручка GET /api/auth/test/code — ТОЛЬКО для разработки, в рабочем окружении false
AUTH_TEST_ENDPOINTS=true

# Телефоны администраторов через запятую
ADMIN_PHONES=+79990000001
